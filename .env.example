# ─────────────────────────────────────────────────────────────────────────
# Next.js app environment variables
# Copy this file to .env.local for local development.
# In Vercel, set these under Project Settings → Environment Variables.
# ─────────────────────────────────────────────────────────────────────────

# Public site URL. Used for canonical URLs, sitemap.xml, robots.txt, and
# Open Graph metadata. Set to your real production domain in Vercel.
NEXT_PUBLIC_SITE_URL=http://localhost:3000

# ── Sanity ──────────────────────────────────────────────────────────────
# Optional. Leave both blank to run the site on local /data fixtures with
# zero configuration. Set both to connect Sanity — get these values from
# https://www.sanity.io/manage after creating a project (see docs/SANITY.md).
NEXT_PUBLIC_SANITY_PROJECT_ID=
NEXT_PUBLIC_SANITY_DATASET=production
NEXT_PUBLIC_SANITY_API_VERSION=2024-06-01

# Optional. Only needed if you later add draft previews or authenticated
# writes from the Next.js app. Never prefixed with NEXT_PUBLIC_ — this is
# read only on the server (Server Components / build time) and is never
# sent to the browser. Required for scripts/migrate-content.mjs (needs a
# token with write access).
SANITY_API_TOKEN=

# Optional, defaults to false. Controls what happens when a configured
# Sanity fetch fails: false falls back to local /data content and keeps
# the site up (logged loudly either way); true re-throws instead, which
# fails the request — and fails the Vercel build outright for
# statically-generated pages — instead of silently drifting on stale
# fallback content. See lib/sanity/client.ts.
SANITY_STRICT_MODE=false

# ── Cloudinary ──────────────────────────────────────────────────────────
# Required if you're serving media through Cloudinary. Find this in your
# Cloudinary dashboard (see docs/CLOUDINARY.md). Delivery URLs are public
# by design — this is safe to expose to the browser.
NEXT_PUBLIC_CLOUDINARY_CLOUD_NAME=

# ─────────────────────────────────────────────────────────────────────────
# Sanity Studio environment variables live in sanity/.env — see
# sanity/.env.example. They are a separate project with its own install.
# ─────────────────────────────────────────────────────────────────────────
